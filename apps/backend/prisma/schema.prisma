generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PARENT
  ADMIN
  SUPERADMIN
}

enum Gender {
  MALE
  FEMALE
}

enum VisitStatus {
  CHECKED_IN
  CHECKED_OUT
  AUTO_CLOSED
}

enum MealType {
  BREAKFAST
  SNACK_MORNING
  LUNCH
  SNACK_AFTERNOON
}

enum ReservationType {
  BIRTHDAY
  PRIVATE_EVENT
  GROUP_BOOKING
  MONTHLY_EVENT
  // Sve sto nije u spisku. Naziv tada upisuje osoblje u `customType`, pa nema
  // potrebe za migracijom svaki put kad se pojavi nova vrsta rezervacije.
  OTHER
}

// Vrste obavestenja. Ime nosi sta se desilo, ne kome se salje - isti dogadjaj
// ide i roditelju i osoblju, samo sa razlicitim tekstom.
enum NotificationType {
  CHILD_CHECKED_IN
  CHILD_CHECKED_OUT
  PARENT_REGISTERED
  CHILD_ADDED
  CHILD_REMOVED
  PACKAGE_ASSIGNED
  HOURS_ADJUSTED
  // Osoblje je naplatilo minus sate; roditelju to zatvara krug.
  DEBT_SETTLED
}

// Kako se akcija izrazava. TEXT je za one koje nisu broj ("drugo dete
// besplatno") - tada vrednost ostaje prazna, a sve pise u nazivu i opisu.
enum DiscountType {
  PERCENT
  AMOUNT
  TEXT
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// Dogadjaji imaju svoje enume iako danas nose iste vrednosti kao rezervacije.
// Evidencija je interna, pa tipovi mogu da se dodaju samo ovde, bez diranja
// onoga sto roditelji vide.
enum EventType {
  BIRTHDAY
  PRIVATE_EVENT
  GROUP_BOOKING
  // Sve sto nije u spisku. Naziv tada upisuje osoblje u `customType`, pa nema
  // potrebe za migracijom svaki put kad se pojavi nova vrsta dogadjaja.
  OTHER
}

enum EventStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  phone     String?
  role      Role     @default(PARENT)
  avatarUrl String?  @map("avatar_url")
  isActive  Boolean  @default(true) @map("is_active")
  pushToken String?  @map("push_token")
  // Trenutak poslednje promene lozinke. Tokeni izdati pre toga se odbijaju, pa
  // promena lozinke stvarno izbacuje tudji uredjaj koji je ostao prijavljen.
  passwordChangedAt DateTime? @map("password_changed_at")
  // Sati odigrani bez pokrica u paketu - "minus sati". Raste pri odjavi kad
  // paket ne pokriva boravak, a pada kad roditelj plati ili dobije nov paket.
  debtHours Decimal  @default(0) @map("debt_hours") @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  children         Child[]
  userPackages     UserPackage[]
  blogPosts        BlogPost[]
  reservations     Reservation[]
  events           Event[]
  checkedInVisits  Visit[]          @relation("CheckedInBy")
  checkedOutVisits Visit[]          @relation("CheckedOutBy")
  hourAdjustments  HourAdjustment[]
  notifications    Notification[]

  @@map("users")
}

model Child {
  id          String   @id @default(uuid())
  parentId    String   @map("parent_id")
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  dateOfBirth DateTime @map("date_of_birth") @db.Date
  gender      Gender?
  allergies   String?
  notes       String?
  qrCode      String   @unique @map("qr_code")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent User    @relation(fields: [parentId], references: [id], onDelete: Cascade)
  visits Visit[]

  @@map("children")
}

// Cena se ne vodi ovde - naplata ide preko racuna, van aplikacije.
// Aplikacija sluzi samo za pracenje sati.
model Package {
  id           String   @id @default(uuid())
  name         String
  description  String?
  totalHours   Decimal  @map("total_hours") @db.Decimal(10, 2)
  validityDays Int      @map("validity_days")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  userPackages UserPackage[]

  @@map("packages")
}

model UserPackage {
  id        String @id @default(uuid())
  userId    String @map("user_id")
  packageId String @map("package_id")

  // Ukupan broj sati se upisuje u trenutku dodele i vise se ne menja.
  // Da se cita iz Package.totalHours, izmena paketa u adminu bi unazad
  // pokvarila racunicu vec dodeljenih paketa ("iskorisceno X od Y").
  totalHours     Decimal  @map("total_hours") @db.Decimal(10, 2)
  remainingHours Decimal  @map("remaining_hours") @db.Decimal(10, 2)
  purchasedAt    DateTime @default(now()) @map("purchased_at")
  expiresAt      DateTime @map("expires_at")
  isActive       Boolean  @default(true) @map("is_active")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  package         Package          @relation(fields: [packageId], references: [id])
  visits          Visit[]
  hourAdjustments HourAdjustment[]

  @@map("user_packages")
}

model Visit {
  id              String      @id @default(uuid())
  childId         String      @map("child_id")
  userPackageId   String?     @map("user_package_id")
  checkedInAt     DateTime    @map("checked_in_at")
  checkedOutAt    DateTime?   @map("checked_out_at")
  durationMinutes Int?        @map("duration_minutes")
  // Naplaceni sati, ne "skinuti sa paketa": kad paket ne pokrije ceo boravak,
  // ovde stoji pun iznos, a razlika je u `debtHours`.
  hoursCharged    Decimal?    @map("hours_charged") @db.Decimal(10, 2)
  // Deo naplacenog koji nije imao pokrice u paketu. Sam dug se vodi na
  // roditelju; ovde stoji da bi se videlo iz koje posete je nastao.
  debtHours       Decimal?    @map("debt_hours") @db.Decimal(10, 2)
  // Ko je prijavio i odjavio dete. Opciono jer nalog osoblja moze biti obrisan,
  // a poseta mora da prezivi - istorija igraonice ne sme da nestane sa nalogom.
  checkedInById   String?     @map("checked_in_by")
  checkedOutById  String?     @map("checked_out_by")
  status          VisitStatus @default(CHECKED_IN)
  notes           String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  child        Child        @relation(fields: [childId], references: [id])
  userPackage  UserPackage? @relation(fields: [userPackageId], references: [id])
  checkedInBy  User?        @relation("CheckedInBy", fields: [checkedInById], references: [id], onDelete: SetNull)
  checkedOutBy User?        @relation("CheckedOutBy", fields: [checkedOutById], references: [id], onDelete: SetNull)

  @@map("visits")
}

model BlogPost {
  id            String    @id @default(uuid())
  title         String
  slug          String    @unique
  content       String
  excerpt       String?
  coverImageUrl String?   @map("cover_image_url")
  // Isto kao kod poseta: tekst ostaje na sajtu i kad autor obrise svoj nalog.
  authorId      String?   @map("author_id")
  isPublished   Boolean   @default(false) @map("is_published")
  isFeatured    Boolean   @default(false) @map("is_featured")
  publishedAt   DateTime? @map("published_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@map("blog_posts")
}

model MenuItem {
  id          String   @id @default(uuid())
  date        DateTime @db.Date
  mealType    MealType @map("meal_type")
  name        String
  description String?
  allergens   String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([date, mealType])
  @@map("menu_items")
}

model Activity {
  id           String    @id @default(uuid())
  title        String
  description  String?
  dayOfWeek    Int       @map("day_of_week")
  startTime    String    @map("start_time")
  endTime      String    @map("end_time")
  ageGroup     String?   @map("age_group")
  color        String?
  isRecurring  Boolean   @default(true) @map("is_recurring")
  specificDate DateTime? @map("specific_date") @db.Date
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("activities")
}

model Reservation {
  id           String            @id @default(uuid())
  userId       String?           @map("user_id")
  type         ReservationType
  // Popunjeno samo kad je tip OTHER; kod ostalih tipova ostaje prazno.
  customType   String?           @map("custom_type")
  title        String
  date         DateTime          @db.Date
  startTime    String            @map("start_time")
  endTime      String            @map("end_time")
  guestCount   Int?              @map("guest_count")
  childName    String?           @map("child_name")
  childAge     Int?              @map("child_age")
  contactPhone String?           @map("contact_phone")
  notes        String?
  status       ReservationStatus @default(PENDING)
  isFullDay    Boolean           @default(false) @map("is_full_day")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("reservations")
}

// Interna evidencija dogadjaja u igraonici. Ista polja kao rezervacija, ali
// odvojena tabela jer je ovo samo za osoblje: ruta nema javni deo, pa mobilna
// aplikacija nema odakle da ih procita.
model Event {
  id           String      @id @default(uuid())
  userId       String?     @map("user_id")
  type         EventType
  // Popunjeno samo kad je tip OTHER; kod ostalih tipova ostaje prazno.
  customType   String?     @map("custom_type")
  title        String
  date         DateTime    @db.Date
  startTime    String      @map("start_time")
  endTime      String      @map("end_time")
  guestCount   Int?        @map("guest_count")
  childName    String?     @map("child_name")
  childAge     Int?        @map("child_age")
  contactPhone String?     @map("contact_phone")
  notes        String?
  status       EventStatus @default(PENDING)
  isFullDay    Boolean     @default(false) @map("is_full_day")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("events")
}

// Promocija sa slikom. U aplikaciji se prvi put pokaze kao iskacuci prozor, a
// posle toga stoji na pocetnoj iznad galerije. Vise promocija moze da bude
// aktivno istovremeno.
//
// Odvojena je od `Promotion` (akcije/popusti): tamo je racunica popusta, ovde
// slika i tekst koje roditelj vidi kao baner.
model PromoBanner {
  id          String  @id @default(uuid())
  title       String
  description String?
  imageUrl    String? @map("image_url")

  // Iskljuceno znaci da promocija zivi samo na pocetnoj, bez iskacuceg prozora.
  showPopup Boolean @default(true) @map("show_popup")

  // Nema roka vazenja: promocija stoji dok je osoblje ne iskljuci ili obrise,
  // a ukljucuje se ponovo kad god zatreba.
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("promo_banners")
}

// Akcija koja vazi u odredjenom periodu. Datumi su @db.Date jer akcija traje
// cele dane - vreme bi ovde samo pravilo probleme oko ponoci i vremenskih zona.
model Promotion {
  id          String  @id @default(uuid())
  title       String
  description String?

  discountType  DiscountType @default(PERCENT) @map("discount_type")
  // Prazno kod TEXT akcija. Decimal, ne Float, iz istog razloga kao i sati u
  // paketima: novac i procenti ne smeju da skupljaju gresku zaokruzivanja.
  discountValue Decimal?     @map("discount_value") @db.Decimal(10, 2)

  dateFrom DateTime @map("date_from") @db.Date
  dateTo   DateTime @map("date_to") @db.Date

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([dateFrom, dateTo])
  @@map("promotions")
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// Dan kada igraonica ne radi (rodjendan, privatna proslava, praznik...).
// Jedan red po datumu - zato @unique: dan je ili neradni ili nije.
// `reason` je kratak tekst koji roditelj vidi u aplikaciji, pa nije enum -
// razlozi su previse raznovrsni da bi se unapred pobrojali.
model ClosedDay {
  id        String   @id @default(uuid())
  date      DateTime @unique @db.Date
  reason    String
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("closed_days")
}

model HourAdjustment {
  id            String   @id @default(uuid())
  userPackageId String   @map("user_package_id")
  adjustedById  String   @map("adjusted_by")
  hoursBefore   Decimal  @map("hours_before") @db.Decimal(10, 2)
  hoursAfter    Decimal  @map("hours_after") @db.Decimal(10, 2)
  reason        String?
  createdAt     DateTime @default(now()) @map("created_at")

  userPackage UserPackage @relation(fields: [userPackageId], references: [id])
  adjustedBy  User        @relation(fields: [adjustedById], references: [id])

  @@map("hour_adjustments")
}

// Obavestenje jednog korisnika o jednom dogadjaju.
//
// Zapis po primaocu, ne po dogadjaju: prijava deteta pravi jedno obavestenje za
// roditelja i po jedno za svakog admina. Tako svako ima svoje "procitano", a
// tekst moze da bude drugaciji ("Vase dete je prijavljeno" vs "Lena Petrovic je
// prijavljena").
//
// `data` nosi id-jeve (dete, poseta, paket) da bi klik mogao da odvede na pravo
// mesto, bez razbijanja teksta na delove.
model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Spisak se uvek cita po primaocu i po vremenu, a broj neprocitanih po
  // primaocu i `read_at`.
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}
