PORT=5000
JWT_SECRET=your_jwt_secret_here_change_this
JWT_EXPIRES_IN=30d
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/igraonica?schema=public"

# Vremenska zona servera.
#
# Dashboard racuna "danas" po lokalnom vremenu procesa (src/utils/day.js), pa
# server mora da radi u zoni igraonice. Ako ostane na UTC, dan bi kod nas
# pocinjao u 01:00 ili 02:00 i jutarnji brojevi bi bili pomereni.
#
# Postavi je u okruzenju u kom se proces pokrece (docker, systemd, pm2), a ne
# ovde - Node cita TZ pri pokretanju, pre nego sto dotenv stigne da ucita .env:
#   TZ=Europe/Belgrade node src/server.js
